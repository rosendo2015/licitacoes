generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum UserRole {
  admin
  customer
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(customer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licitacoes Licitacao[]   // <-- relação inversa


    @@map("users")
}

enum StatusLicitacao {
  EM_ANDAMENTO
  CONCLUIDA
  ADIADA
  SUSPENSA
  REVOGADA
}

model Licitacao {
  id             String   @id @default(uuid())
  data           DateTime // data da licitação
  horarioInicio  String   // horário de início (pode ser string ou DateTime, depende do formato que você quer salvar)
  estado         String   // estado (UF)
  orgao          String   // órgão responsável
  pregao         String   // tipo de pregão
  servico        String   // serviço licitado
  uasg           String   // código UASG
  observacoes    String?  // observações opcionais
  status         StatusLicitacao @default(EM_ANDAMENTO)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // relação com usuário
  userId String
  user   User @relation(fields: [userId], references: [id])
  @@map("licitacoes")
}

